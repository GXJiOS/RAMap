{
  "name": "ramap",
  "version": "0.1.0",
  "private": true,
  "description": "红警 2 / 尤里的复仇地图预览与编辑器",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -s first \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && RAMAP_VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:web": "vite --host 127.0.0.1",
    "test": "vitest run && node --test electron/*.test.cjs",
    "typecheck": "tsc -b",
    "build:web": "tsc -b && vite build",
    "check": "npm run test && npm run build:web",
    "preview": "vite preview --host 127.0.0.1",
    "dist:mac": "make bundle"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^18.19.68",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "39.8.10",
    "electron-builder": "26.15.3",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "wait-on": "7.2.0"
  },
  "build": {
    "appId": "com.gcdm.ramap",
    "productName": "RAMap",
    "electronDist": "node_modules/electron/dist",
    "forceCodeSigning": true,
    "directories": {
      "output": "build",
      "buildResources": "icon"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "icon/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "minimumSystemVersion": "13.0",
      "type": "development",
      "hardenedRuntime": false,
      "timestamp": "none",
      "notarize": false,
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "icon/RAMap.icns"
    }
  }
}
